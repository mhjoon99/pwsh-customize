{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#003543",
          "foreground": "#d2ff5e",
          "powerline_symbol": "",
          "style": "powerline",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "#0087D8",
          "foreground": "#003544",
          "powerline_symbol": "",
          "options": {
            "folder_separator_icon": "/",
            "style": "full"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path",
          "min_width": 120
        },
        {
          "background": "#0087D8",
          "foreground": "#003544",
          "powerline_symbol": "",
          "options": {
            "folder_separator_icon": "/",
            "style": "agnoster_short",
            "max_depth": 2,
            "hide_root_location": true,
            "folder_icon": "…"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path",
          "min_width": 90,
          "max_width": 119
        },
        {
          "background": "#0087D8",
          "foreground": "#003544",
          "powerline_symbol": "",
          "options": {
            "style": "folder"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path",
          "max_width": 89
        },
        {
          "background": "#d2ff5e",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f26d50{{ end }}",
            "{{ if gt .Ahead 0 }}#89d1dc{{ end }}",
            "{{ if gt .Behind 0 }}#f17c37{{ end }}"
          ],
          "foreground": "#193549",
          "powerline_symbol": "",
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true
          },
          "style": "powerline",
          "template": " {{ .HEAD }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#33DD2D{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FFCD58{{end}}",
            "{{if eq \"Full\" .State.String}}#0476d0{{end}}"
          ],
          "foreground": "#242424",
          "invert_powerline": true,
          "powerline_symbol": "",
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}  ",
          "type": "battery"
        },
        {
          "background": "#0087D8",
          "foreground": "#003544",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": true
          },
          "style": "powerline",
          "template": "  {{ .Venv }} ",
          "type": "python"
        },
        {
          "background": "#003543",
          "foreground": "#fff",
          "invert_powerline": true,
          "powerline_symbol": "",
          "style": "powerline",
          "template": "<#fff>  </>{{ .CurrentDate | date .Format }} ",
          "type": "time"
        }
      ],
      "type": "prompt",
      "overflow": "hide"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#FFD700",
          "style": "plain",
          "template": " ⚡ ",
          "type": "root"
        },
        {
          "foreground": "#f1184c",
          "style": "plain",
          "template": "{{ if .Segments.Contains \"Git\" }}{{ $g := .Segments.Git }}{{ if gt $g.Working.Unmerged 0 }}🙀 <#9a9a9a>conflict</>{{ else if $g.Rebase }}🙀 <#9a9a9a>rebasing</>{{ else if $g.Merge }}🙀 <#9a9a9a>merging</>{{ else if $g.CherryPick }}🙀 <#9a9a9a>cherry-picking</>{{ else if $g.Revert }}🙀 <#9a9a9a>reverting</>{{ else if and (gt $g.Ahead 0) (gt $g.Behind 0) }}😾 <#9a9a9a>diverged ↑{{ $g.Ahead }} ↓{{ $g.Behind }}</>{{ else if gt $g.Behind 0 }}😿 <#9a9a9a>behind ↓{{ $g.Behind }}</>{{ else if and $g.Staging.Changed $g.Working.Changed }}😹 <#9a9a9a>partially staged</>{{ else if $g.Staging.Changed }}😻 <#9a9a9a>ready to commit</>{{ else if $g.Working.Changed }}😼 <#9a9a9a>modified</>{{ else if gt $g.Ahead 0 }}😸 <#9a9a9a>unpushed ↑{{ $g.Ahead }}</>{{ else if gt $g.StashCount 0 }}😽 <#9a9a9a>stashed {{ $g.StashCount }}</>{{ else }}😺{{ end }}{{ else }}🐱{{ end }} {{ if gt .Code 0 }}<#f1184c>❯</>{{ else }}<#33DD2D>❯</>{{ end }}",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#FFD700",
    "template": "{{if .Root}}⚡ {{end}}🐱 {{ if gt .Code 0 }}<#f1184c>❯</>{{ else }}<#33DD2D>❯</>{{ end }} "
  },
  "version": 4
}
